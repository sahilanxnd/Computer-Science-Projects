# TiDB Cloud (recommended) — from console.tidbcloud.com → Connect → General → Public
DB_HOST=gateway01.us-west-2.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=xxxxxxxx.root
DB_PASSWORD=your_tidb_password
DB_NAME=videoapp
TIDB_ENABLE_SSL=true

# Local dev server port (not used on Vercel)
PORT=3000
NODE_ENV=development

# Optional: only for TiDB Dedicated with a downloaded CA file
# DB_CA_PATH=C:/path/to/isrgrootx1.pem
